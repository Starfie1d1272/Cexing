+// SetHostRouting installs the host lookup before any outbound is chosen.
+func SetHostRouting(resolve, udpKey func(*C.Metadata) (string, error)) {
+	hostRouting.Store(&hostRoutingHook{resolve: resolve, udpKey: udpKey})
+}
+
+func HostRouteTargets() []string {
+	configMux.RLock()
+	defer configMux.RUnlock()
+	names := []string{"DIRECT"}
+	for name, proxy := range proxies {
+		if name == "DIRECT" || name == "GLOBAL" || len(name) > 256 || strings.ContainsAny(name, "\r\n\x00") {
+			continue
+		}
+		if _, ok := proxy.Adapter().(interface{ GetProxies(bool) []C.Proxy }); ok {
+			names = append(names, name)
+		}
+	}
+	slices.Sort(names)
+	if len(names) > 4096 {
+		names = names[:4096]
+	}
+	return names
+}
