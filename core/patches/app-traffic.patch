+// TrackerObserver receives deltas on the counting goroutine. Implementations must
+// not perform IO. A tracker retains its handle through Close and late counts.
+type TrackerObserver interface {
+	Add(upload, download int64)
+	Close()
+}
+
+type trackerObserverFactory struct {
+	create func(*TrackerInfo) TrackerObserver
+}
+
+var hostObserver stdatomic.Pointer[trackerObserverFactory]
+
+func SetTrackerObserver(create func(*TrackerInfo) TrackerObserver) {
+	if create == nil {
+		hostObserver.Store(nil)
+		return
+	}
+	hostObserver.Store(&trackerObserverFactory{create: create})
+}
+
+func observeTracker(info *TrackerInfo, conn C.Connection, push bool) TrackerObserver {
+	if route, ok := conn.(interface{ TrafficRoute() string }); ok {
+		info.TrafficRoute = route.TrafficRoute()
+	}
+	if factory := hostObserver.Load(); push && factory != nil {
+		observer := factory.create(info)
+		if observer != nil {
+			observer.Add(info.UploadTotal.Load(), info.DownloadTotal.Load())
+		}
+		return observer
+	}
+	return nil
+}
 
