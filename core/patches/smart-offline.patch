+package route
+
+import (
+	"encoding/json"
+	"github.com/metacubex/chi"
+	"github.com/metacubex/http"
+	"github.com/metacubex/mihomo/adapter/outboundgroup"
+	"github.com/metacubex/mihomo/component/smart/lightgbm"
+	"github.com/metacubex/mihomo/tunnel"
+)
+
+// The external router is mounted behind the existing Controller authentication.
+// Status includes no credentials/paths and makes no inference from weight rankings.
+func addOHOSSmartRoutes(r chi.Router, secret string) {
+	if secret == "" {
+		return
+	}
+	r.Post("/smart/model", func(w http.ResponseWriter, r *http.Request) {
+		if err := lightgbm.InstallModel(http.MaxBytesReader(w, r.Body, 9345218+1)); err != nil {
+			w.Header().Set("Content-Type", "application/json")
+			w.WriteHeader(http.StatusBadRequest)
+			json.NewEncoder(w).Encode(map[string]any{"error": err.Error()})
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(map[string]any{"installed": true, "sha256": lightgbm.ModelSHA256,
+			"restartRequired": lightgbm.ModelStatus().State != "not-requested", "message": "模型已校验安装；已尝试加载模型的进程需结束并重启，VPN 停止/启动不能重置模型状态"})
+	})
+	r.Get("/smart/status", func(w http.ResponseWriter, r *http.Request) {
+		groups := make(map[string]json.RawMessage)
+		for name, proxy := range tunnel.Proxies() {
+			if group, ok := proxy.Adapter().(*outboundgroup.Smart); ok {
+				if data, err := group.MarshalJSON(); err == nil {
+					groups[name] = data
+				}
+			}
+		}
+		status := lightgbm.ModelStatus()
+		message := "Smart 使用统计策略；LightGBM 尚未请求加载"
+		switch status.State {
+		case "loading":
+			message = "正在校验并加载离线模型"
+		case "missing":
+			message = "离线模型缺失，Smart 使用统计策略；安装模型后需重新启动应用进程"
+		case "invalid":
+			message = "离线模型校验或解析失败，Smart 使用统计策略；原文件保留，替换后需重新启动应用进程"
+		case "loaded":
+			message = "离线模型已加载；成功预测次数为零时尚无 LightGBM 参与证据"
+		}
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(map[string]any{
+			"schemaVersion": 1, "core": "daf3ad03021cca6031f4a7303ca6d861a14d5a16",
+			"groups": groups, "model": status, "message": message,
+		})
+	})
+}
