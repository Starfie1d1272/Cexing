+// Status reads never load a model. Predictions count only valid PredictSingle results.
+var modelState atomic.Value
+var modelPredictions atomic.Uint64
+
+const ModelSHA256 = "23633022a815fb34e510befe1c176ba50af3ced48f08b172454f4cd6b8327788"
+
+type Status struct {
+	State           string `json:"state"`
+	SHA256          string `json:"sha256"`
+	Predictions     uint64 `json:"predictions"`
+	NetworkDownload bool   `json:"networkDownload"`
+	RestartRequired bool   `json:"restartRequired"`
+}
+
+func ModelStatus() Status {
+	state, _ := modelState.Load().(string)
+	if state == "" {
+		state = "not-requested"
+	}
+	return Status{State: state, SHA256: ModelSHA256, Predictions: modelPredictions.Load(), RestartRequired: state == "missing" || state == "invalid"}
+}
+
+// InstallModel validates the exact pinned upstream asset before atomic replacement.
+// No download, hot reload or runtime reset. Missing-model users restart the process.
+func InstallModel(reader io.Reader) error {
+	data, err := io.ReadAll(io.LimitReader(reader, 9345218+1))
+	if err != nil || len(data) != 9345218 {
+		return fmt.Errorf("模型读取失败或大小不匹配")
+	}
+	digest := sha256.Sum256(data)
+	if hex.EncodeToString(digest[:]) != ModelSHA256 {
+		return fmt.Errorf("模型 SHA-256 与支持的上游版本不匹配")
+	}
+	installMutex.Lock()
+	defer installMutex.Unlock()
+	path := C.Path.SmartModel()
+	f, err := os.CreateTemp(filepath.Dir(path), ".smart-model-*")
+	if err != nil {
+		return fmt.Errorf("无法写入应用模型目录")
+	}
+	defer os.Remove(f.Name())
+	if _, err = f.Write(data); err != nil {
+		f.Close()
+		return fmt.Errorf("模型写入失败")
+	}
+	if err = f.Sync(); err != nil {
+		f.Close()
+		return fmt.Errorf("模型同步失败")
+	}
+	if err = f.Close(); err != nil {
+		return fmt.Errorf("模型关闭失败")
+	}
+	if _, err = leaves.LGEnsembleFromFile(f.Name(), false); err != nil {
+		return fmt.Errorf("模型解析失败")
+	}
+	if st, err := os.Stat(path); err == nil && st.Size() > 9345218 {
+		return fmt.Errorf("旧模型过大，请先保存诊断副本")
+	}
+	old, err := os.ReadFile(path)
+	if err != nil && !os.IsNotExist(err) {
+		return fmt.Errorf("旧模型读取失败，安装未替换原文件；请检查文件权限")
+	}
+	if err == nil {
+		// Keep a diagnostic copy of a replaced invalid resource; never overwrite it.
+		hash := sha256.Sum256(old)
+		if hex.EncodeToString(hash[:]) != ModelSHA256 {
+			backup, err := os.OpenFile(path+".previous", os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+			if err != nil {
+				return fmt.Errorf("旧模型备份已存在或不可写，请先保存诊断副本")
+			}
+			_, err = backup.Write(old)
+			closeErr := backup.Close()
+			if err != nil || closeErr != nil {
+				return fmt.Errorf("旧模型备份失败")
+			}
+		}
+	}
+	if err = os.Rename(f.Name(), path); err != nil {
+		return fmt.Errorf("模型原子安装失败")
+	}
+	return nil
+}
