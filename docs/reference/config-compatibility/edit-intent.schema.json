{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cexing.local/schema/edit-intent-v1",
  "title": "Private per-subscription EditIntent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "sourceRevision",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    },
    "disabled": {
      "type": "boolean"
    },
    "smartGroups": {
      "type": "object",
      "maxProperties": 512,
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "operations": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "section"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "add",
              "update",
              "delete",
              "move",
              "rename",
              "disable"
            ]
          },
          "section": {
            "enum": [
              "proxies",
              "proxy-providers",
              "proxy-groups",
              "rules",
              "rule-providers",
              "dns",
              "hosts"
            ]
          },
          "target": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "preconditions": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "value": {},
          "patch": {
            "type": "object"
          },
          "remove": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "before": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "templateId": {
            "enum": [
              "region",
              "ai",
              "automatic",
              "routing"
            ]
          }
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateId",
        "version"
      ],
      "properties": {
        "templateId": {
          "enum": [
            "original",
            "region",
            "ai",
            "automatic",
            "routing"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "targetGroup": {
          "type": "string"
        },
        "region": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "selector",
            "enable"
          ],
          "properties": {
            "mode": {
              "enum": [
                "region",
                "all"
              ]
            },
            "selector": {
              "type": "string"
            },
            "enable": {
              "type": "boolean"
            },
            "disabled": {
              "type": "boolean"
            },
            "assignments": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "replaceRules": {
          "type": "boolean"
        },
        "baseline": {
          "$ref": "#/$defs/templateSnapshot"
        },
        "mine": {
          "$ref": "#/$defs/templateSnapshot"
        },
        "routing": {
          "$ref": "#/$defs/routingPlan"
        }
      },
      "dependentRequired": {
        "baseline": [
          "mine"
        ],
        "mine": [
          "baseline"
        ]
      }
    },
    "templateArchives": {
      "type": "object",
      "maxProperties": 4,
      "propertyNames": {
        "enum": [
          "region",
          "ai",
          "automatic",
          "routing"
        ]
      },
      "additionalProperties": {
        "$ref": "#/properties/template"
      }
    }
  },
  "$defs": {
    "templateSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateId",
        "version",
        "entries"
      ],
      "properties": {
        "templateId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_./-]{0,127}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "entries": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "section",
              "value"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_./-]{0,127}$"
              },
              "section": {
                "enum": [
                  "proxies",
                  "proxy-providers",
                  "proxy-groups",
                  "rules",
                  "rule-providers",
                  "dns",
                  "hosts"
                ]
              },
              "value": {}
            }
          }
        },
        "deleted": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_./-]{0,127}$"
          }
        }
      }
    },
    "routingPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "outlets",
        "routes",
        "overlayRulesDigest"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "enum": [
            "subscription",
            "managed"
          ]
        },
        "defaultOutlet": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "overlayRulesDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "assignments": {
          "type": "object",
          "maxProperties": 16384,
          "additionalProperties": {
            "type": "string"
          }
        },
        "outlets": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "algorithm",
              "scope"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "algorithm": {
                "enum": [
                  "smart",
                  "url-test",
                  "fallback",
                  "select"
                ]
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "regions",
                  "excludeRegions",
                  "nodes",
                  "excludeNodes",
                  "providers",
                  "unknown"
                ],
                "properties": {
                  "regions": {
                    "type": "array",
                    "maxItems": 16384,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "excludeRegions": {
                    "type": "array",
                    "maxItems": 16384,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "nodes": {
                    "type": "array",
                    "maxItems": 16384,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "excludeNodes": {
                    "type": "array",
                    "maxItems": 16384,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "providers": {
                    "type": "array",
                    "maxItems": 16384,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "unknown": {
                    "enum": [
                      "include",
                      "exclude"
                    ]
                  }
                }
              },
              "order": {
                "type": "array",
                "maxItems": 16384,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "options": {
                "type": "object"
              }
            }
          }
        },
        "routes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "services",
              "outlet"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "outlet": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "services": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
