{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "metadata": [
      { "name": "ohos.arkui.UIMaterial.state", "value": "enable" }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "launchType": "singleton",
        "metadata": [{ "name": "ohos.ability.shortcuts", "resource": "$profile:shortcuts" }],
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "backgroundModes": ["dataTransfer"],
        "icon": "$media:app_icon_layered",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:app_icon_foreground",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          {
            "actions": ["ohos.want.action.viewData"],
            "entities": ["entity.system.browsable"],
            "uris": [{ "scheme": "cexing", "host": "import" },
              { "scheme": "clash", "host": "install-config" }]
          },
          {
            "actions": ["ohos.want.action.sendData"],
            "uris": [{ "scheme": "file", "utd": "general.text", "maxFileSupported": 1 },
              { "scheme": "file", "utd": "general.hyperlink", "maxFileSupported": 1 },
              { "scheme": "file", "utd": "general.file", "maxFileSupported": 1 }]
          },
          {
            "actions": ["ohos.want.action.viewData"],
            "uris": [{ "scheme": "file", "host": "docs", "type": "application/yaml" },
              { "scheme": "file", "host": "docs", "type": "text/yaml" }]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "ConnectionFormAbility",
        "srcEntry": "./ets/connectionform/ConnectionFormAbility.ets",
        "type": "form",
        "exported": true,
        "metadata": [{ "name": "ohos.extension.form", "resource": "$profile:connection_form" }]
      },
      {
        "name": "CexingVpnAbility",
        "srcEntry": "./ets/vpnability/CexingVpnAbility.ets",
        "type": "vpn"
      }
    ]
  }
}
