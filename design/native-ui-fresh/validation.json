  "flows": [
    {
      "name": "URL 格式错误保留输入 → 示例导入 → Merge 草稿 / 差异 → 启用 → 拒绝授权 → 重试授权 → 取消连接过滤迟到回调 → 连接成功 / 合成速率",
      "passed": true
    },
    {
      "name": "Zashboard 加载失败 → 重试 → 返回，VPN 保持连接",
      "passed": true
    },
    {
      "name": "更新失败保留上份配置 → 恢复后更新 → 重命名转义 → 合成导出 → 设置开关 / 分流 / 非法端口 → 分层诊断 / 脱敏摘要",
      "passed": true
    },
    {
      "name": "确认断开 → 断开中 → 未连接，面板禁用",
      "passed": true
    },
    {
      "name": "网络中断 → 网络条件恢复 → 手动重试连接",
      "passed": true
    },
    {
      "name": "首次导入失败 → 保留链接与名称 → 重试成功",
      "passed": true
    },
    {
      "name": "本地文件导入 → 无更新入口 → 删除 → 手动粘贴 YAML 导入",
      "passed": true
    },
    {
      "name": "已连接时删除当前订阅：先断开，再删除",
      "passed": true
    },
    {
      "name": "授权弹窗键盘焦点限定 / Escape 返回",
      "passed": true
    },
    {
      "name": "固定三页签：长设置页滚动后仍可切换 → 订阅 → 连接，VPN 不停止",
      "passed": true
    },
    {
      "name": "连接中切换设置：异步启动继续，返回连接页显示完成结果",
      "passed": true
    },
    {
      "name": "减少动态效果：连接中 spinner 无动画，状态 / 取消仍可用",
      "passed": true
    }
